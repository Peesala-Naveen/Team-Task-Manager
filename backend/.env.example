# Server Configuration
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/teamtaskmanager

# Secret Key for JSON Web Token (JWT) Signing
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Client Origin for Production CORS Configuration (Comma-separated)
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend-domain.vercel.app